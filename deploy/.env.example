# Kopieren nach deploy/.env (wird nicht eingecheckt) oder als GitHub-Secrets hinterlegen
DOMAIN=chat.ncg-it.com
ACME_EMAIL=

# Erzeugen mit: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Scaleway IAM API-Key (Secret Key) mit Permission Set "GenerativeApisModelAccess"
SCW_GENAI_API_KEY=
SCW_GENAI_BASE_URL=https://api.scaleway.ai/v1

# Für den allerersten Login auf true, danach wieder false
ENABLE_SIGNUP=true
