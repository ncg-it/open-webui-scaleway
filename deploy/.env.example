# Copy to deploy/.env (not committed) or store as GitHub secrets
DOMAIN=chat.ncg-it.com
ACME_EMAIL=

# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Scaleway IAM API key (secret key) with permission set "GenerativeApisModelAccess"
SCW_GENAI_API_KEY=
SCW_GENAI_BASE_URL=https://api.scaleway.ai/v1

# Internal SearXNG search engine (openssl rand -hex 32)
SEARXNG_SECRET=

# API key for Open Terminal (openssl rand -hex 32)
OPEN_TERMINAL_API_KEY=

# Default model (only applies to a fresh install, afterwards use the admin panel)
DEFAULT_MODELS=mistral-medium-3.5-128b

# App name (Open WebUI appends " (Open WebUI)")
WEBUI_NAME=NCG IT Consulting Chat

# Set to true for the very first login, then back to false
ENABLE_SIGNUP=true

# Token usage tracking (enabled by default)
# Tracks token usage per user, model, and conversation for cost monitoring
# Settings take effect on fresh install; for existing installations, enable in Admin Panel -> Settings
ENABLE_TOKEN_USAGE_TRACKING=true
TOKEN_USAGE_TRACKING_MODE=all
